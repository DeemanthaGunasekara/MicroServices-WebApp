# ==============================================================================
# MicroServices-WebApp — Environment Configuration Template
# ==============================================================================
# NOTICE: Do NOT commit real secret values to Git!
# Copy this file to '.env' for local development:
#   cp .env.example .env
# For GitHub Actions CI/CD, configure these in:
#   Repository Settings -> Secrets and variables -> Actions
# ==============================================================================

# Node Environment
NODE_ENV=development

# User Service Configuration
USER_SERVICE_PORT=3000
DB_HOST=postgres-service
DB_PORT=5432
DB_USER=app_user
DB_PASSWORD=placeholder_db_password_never_commit_real_values
JWT_SECRET=placeholder_jwt_secret_token_change_in_production

# Product Service Configuration
PRODUCT_SERVICE_PORT=3001
CATALOG_API_URL=https://dummyjson.com/products

# Frontend Configuration
FRONTEND_PORT=80